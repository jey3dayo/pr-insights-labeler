{
  "name": "pr-insights-labeler",
  "version": "1.12.0",
  "description": "PR Insights Labeler delivers intelligent PR analysis with automated size, category, risk, and complexity labels for GitHub Actions",
  "author": "jey3dayo",
  "license": "MIT",
  "homepage": "https://github.com/jey3dayo/pr-insights-labeler",
  "repository": {
    "type": "git",
    "url": "https://github.com/jey3dayo/pr-insights-labeler.git"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@11.26.0",
  "main": "dist/index.js",
  "scripts": {
    "generate:i18n-types": "tsx scripts/generate-i18n-types.ts",
    "postinstall": "pnpm generate:i18n-types",
    "prepare": "if command -v lefthook >/dev/null 2>&1; then lefthook install; else echo 'lefthook not found: git hooks NOT installed (run: mise install)'; fi",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist",
    "build": "run-s clean build:compile",
    "build:compile": "ncc build src/main.ts -o dist --source-map --license licenses.txt --quiet",
    "test": "run-p lint test:vitest",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:quick": "run-p eslint type-check",
    "lint": "run-p eslint type-check prettier",
    "eslint": "eslint . --cache --cache-strategy content",
    "eslint:fix": "eslint . --fix --cache --cache-strategy content",
    "type-check": "tsc --noEmit",
    "format": "run-s prettier:write eslint:fix",
    "prettier": "prettier --check .",
    "prettier:write": "prettier --write . --log-level warn",
    "depcruise": "depcruise --config .dependency-cruiser.js src",
    "knip": "knip"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@typescript-eslint/parser": "^8.70.0",
    "bytes": "^3.1.2",
    "eslint": "^9.39.5",
    "i18next": "^25.10.10",
    "js-yaml": "^5.4.1",
    "minimatch": "^10.2.6",
    "neverthrow": "^8.2.0",
    "p-limit": "3.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@types/bytes": "^3.1.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.0",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-neverthrow": "^1.1.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "knip": "^6.34.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "github-action",
    "pr-metrics",
    "file-size",
    "code-review",
    "pull-request",
    "label",
    "automation",
    "pr-insights-labeler"
  ]
}
